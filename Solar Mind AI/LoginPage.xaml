<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Solar_Mind_AI.LoginPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">


    <Grid>
    <Image Aspect="AspectFill" Source="login_bg.jpeg"/>
    <!-- الطبقة التانية: المحتوى كله -->
        <VerticalStackLayout VerticalOptions="Start" Spacing="0" Margin="25, 190, 25, 0">

            <!-- نص الترحيب الملون -->
            <Label HorizontalOptions="Center" FontSize="28" FontAttributes="Bold" Margin="0, 0, 0, 5">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Welcome " TextColor="#0D47A1" />
                        <Span Text="Back!" TextColor="#4CAF50" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <!-- الجملة اللي تحتها -->
            <Label Text="Log in to continue your journey&#10;towards a clean future" 
                   TextColor="Gray" HorizontalOptions="Center" HorizontalTextAlignment="Center" FontSize="14" Margin="0, 0, 0, 30" />

            <!-- البوكس الأبيض بتاع تسجيل الدخول -->
            <Border BackgroundColor="White" StrokeThickness="0" Padding="20, 20, 20, 20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,5" Radius="15" Opacity="0.1" />
                </Border.Shadow>

                <!-- محتويات البوكس (خانات الكتابة والزرار بالشكل الجديد) -->
                <VerticalStackLayout Spacing="15">

                    <!-- رسالة الخطأ (مخفية في البداية) -->
                    

                    <!-- بوكس الإيميل -->
                    <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" Padding="15,0" HeightRequest="55">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto, *">
                            <Image Source="user_icon.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Margin="0,0,10,0"/>
                            <Entry x:Name="EmailEntry" Grid.Column="1" Placeholder="Email or Phone" BackgroundColor="Transparent" TextColor="Black" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- بوكس الباسورد -->
                    <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" Padding="15,0" HeightRequest="55">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Image Source="lock_icon.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Margin="0,0,10,0"/>
                            <Entry x:Name="PasswordEntry" Grid.Column="1" Placeholder="Password" IsPassword="True" BackgroundColor="Transparent" TextColor="Black" VerticalOptions="Center" />
                            <ImageButton Grid.Column="2" Source="eye_icon.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" VerticalOptions="Center" BackgroundColor="Transparent" Clicked="OnEyeClicked"/>
                        </Grid>
                    </Border>

                    <!-- نص نسيان كلمة المرور -->
                    <Label Text="Forgot Password?" TextColor="#03A9F4" HorizontalOptions="End" FontSize="14">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- زرار الدخول المتدرج (أخضر لأزرق) وفوقه السهم -->
                    <Grid>
                        <Button Text="Log In" Clicked="OnLogInClicked" TextColor="White" CornerRadius="10" HeightRequest="55" FontSize="18" FontAttributes="Bold">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#8BC34A" Offset="0.0" />
                                    <GradientStop Color="#03A9F4" Offset="1.0" />
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                        <Image Source="arrow_icon.png" WidthRequest="24" HeightRequest="24" Aspect="AspectFit"  HorizontalOptions="End"  VerticalOptions="Center" Margin="0,0,20,0" InputTransparent="True"/>
                    </Grid>

                    <Label HorizontalOptions="Center" Margin="0, 20, 0, 0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Don't have an account? " TextColor="Gray" />
                                <Span Text="Sign Up" TextColor="#4CAF50" FontAttributes="Bold">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSignUpTextTapped" />
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label x:Name="ErrorLabel" TextColor="Red" FontSize="13" IsVisible="False" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>