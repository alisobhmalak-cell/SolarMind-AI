<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Solar_Mind_AI.SignUpPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundImageSource="signup_bg.png">



    <VerticalStackLayout Margin="0,180,0,0" Padding="20, 0, 20, 30" Spacing="8">
        
        <!-- اسم البرنامج واللوجو النصي -->
        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
            <Label HorizontalOptions="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Solar" TextColor="#0D47A1" FontSize="32" FontAttributes="Bold" />
                        <Span Text="Mind" TextColor="#4CAF50" FontSize="32" FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Grid ColumnDefinitions="Auto, Auto, Auto" HorizontalOptions="Center" ColumnSpacing="8">
                <BoxView Grid.Column="0" HeightRequest="1" WidthRequest="25" Color="#8BC34A" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="SMART ENERGY • CLEAN FUTURE" TextColor="#455A64" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
                <BoxView Grid.Column="2" HeightRequest="1" WidthRequest="25" Color="#03A9F4" VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>

        <!-- العناوين -->
        <Label Text="Create Account" FontSize="28" FontAttributes="Bold" TextColor="#0D47A1" HorizontalOptions="Center" Margin="0, 10, 0, 0"/>
        <Label Text="Join us and start your journey&#10;towards a cleaner future" TextColor="Gray" HorizontalTextAlignment="Center" HorizontalOptions="Center" Margin="0, 0, 0, 15"/>

        <!-- الخانات بتاعتك هتكمل هنا عادي جداً -->
        <!-- 1. خانة الاسم -->
        <Border BackgroundColor="White" StrokeThickness="1" Stroke="#E0E0E0" Padding="15, 5">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto, *">
                <Image Source="user_icon.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Margin="0,0,10,0"/>
                <Entry Grid.Column="1" Placeholder="Full Name" TextColor="Black" PlaceholderColor="Gray" BackgroundColor="Transparent" />
            </Grid>
        </Border>

        <!-- 2. خانة الإيميل -->
        <Border BackgroundColor="White" StrokeThickness="1" Stroke="#E0E0E0" Padding="15, 5">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto, *">
                <Image Source="email_icon.png" WidthRequest="26" HeightRequest="26" Aspect="AspectFit" VerticalOptions="Center" Margin="0,0,10,0"/>
                <Entry Grid.Column="1" Placeholder="Email Address" Keyboard="Email" TextColor="Black" PlaceholderColor="Gray" BackgroundColor="Transparent" />
            </Grid>
        </Border>

        <!-- 3. خانة الباسورد -->
        <Border BackgroundColor="White" StrokeThickness="1" Stroke="#E0E0E0" Padding="15, 5">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Image Source="lock_icon.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Margin="0,0,10,0"/>
                <Entry x:Name="PasswordEntry" Grid.Column="1" Placeholder="Password" IsPassword="True" TextColor="Black" PlaceholderColor="Gray" BackgroundColor="Transparent" />
                <Image Grid.Column="2" Source="eye_icon.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEyeClicked" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
        </Border>

        <!-- 4. خانة تأكيد الباسورد -->
        <Border BackgroundColor="White" StrokeThickness="1" Stroke="#E0E0E0" Padding="15, 5">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Image Source="lock_icon.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Margin="0,0,10,0"/>
                <Entry x:Name="ConfirmPasswordEntry" Grid.Column="1" Placeholder="Confirm Password" IsPassword="True" TextColor="Black" PlaceholderColor="Gray" BackgroundColor="Transparent" />
                <Image Grid.Column="2" Source="eye_icon.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnConfirmEyeClicked" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
        </Border>

        <!-- شروط الباسورد -->
        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="5" RowSpacing="8" Margin="5, 5, 5, 10">
            <!-- الشرط الأول -->
            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="5">
                <Label Text="✓" TextColor="#4CAF50" FontAttributes="Bold" VerticalOptions="Center"/>
                <Label Text="At least 8 characters" TextColor="Gray" FontSize="12" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <!-- الشرط التاني -->
            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="5">
                <Label Text="✓" TextColor="#4CAF50" FontAttributes="Bold" VerticalOptions="Center"/>
                <Label Text="One number" TextColor="Gray" FontSize="12" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <!-- الشرط التالت -->
            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="5">
                <Label Text="✓" TextColor="#4CAF50" FontAttributes="Bold" VerticalOptions="Center"/>
                <Label Text="One uppercase letter" TextColor="Gray" FontSize="12" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <!-- الشرط الرابع -->
            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="5">
                <Label Text="✓" TextColor="#4CAF50" FontAttributes="Bold" VerticalOptions="Center"/>
                <Label Text="One special character" TextColor="Gray" FontSize="12" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- زرار Create Account بالتدرج اللوني -->
        <Border StrokeThickness="0" HeightRequest="55" Margin="0, 5, 0, 10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#8BC34A" Offset="0.0" />
                    <GradientStop Color="#03A9F4" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="*, Auto" Padding="20, 0">
                <Label Grid.Column="0" Text="Create Account" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="20,0,0,0"/>
                <Label Grid.Column="1" Text="➔" TextColor="White" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"/>
            </Grid>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCreateAccountClicked" />
            </Border.GestureRecognizers>
        </Border>


        <!-- رابط تسجيل الدخول -->
        <Label HorizontalOptions="Center" Margin="0, 5, 0, 20">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="Already have an account? " TextColor="Gray" />
                    <Span Text="Log In" TextColor="#4CAF50" FontAttributes="Bold">
                        <Span.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLoginTextTapped" />
                        </Span.GestureRecognizers>
                    </Span>
                </FormattedString>
            </Label.FormattedText>
        </Label>

    </VerticalStackLayout>
    </ContentPage>